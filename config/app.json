{
  "bot": {
    "uid": "YOUR_BOT_UID",
    "name": "Yesα",
    "platform": "iirose"
  },
  "roomId": "YOUR_ROOM_ID",
  "auth": {
    "iiroseUsername": "YOUR_IIROSE_USERNAME",
    "iirosePassword": "YOUR_IIROSE_PASSWORD"
  },
  "admins": [
    "YOUR_ADMIN_UID"
  ],
  "permissions": {
    "default": {
      "allowedActions": [
        "chat",
        "help",
        "music"
      ],
      "blockedActions": [
        "admin",
        "system",
        "config"
      ]
    },
    "admin": {
      "allowedActions": [
        "chat",
        "help",
        "music",
        "admin",
        "system",
        "config",
        "message.route"
      ],
      "blockedActions": []
    }
  },
  "runtime": {
    "mode": "workflow",
    "eventTriggersEnabled": false
  },
  "workflow": {
    "maxSteps": 6,
    "maxToolCallsPerStep": 4,
    "allowParallelReadTools": true,
    "maxProviderRetries": 2,
    "promptProfile": {
      "promptDir": "prompt",
      "activePrompt": "角色",
      "persist": true,
      "stateFile": "data/runtime/workflow-prompt-profile.json",
      "memory": {
        "maxEntries": 50
      }
    },
    "chatOutput": {
      "enabled": true,
      "splitDelimiter": "/",
      "typingDelayPerCharMs": 300,
      "maxTypingDelayMs": 5000
    }
  },
  "workflowRunLog": {
    "enabled": true,
    "dataDir": "data/workflow-runs",
    "fileName": "workflow-runs.jsonl",
    "maxBytes": 8388608,
    "targetBytesAfterCompact": 6291456,
    "compactCheckInterval": 10,
    "persist": true
  },
  "openclaw": {
    "agentLabel": "iirose",
    "subagentLabel": "iirose",
    "timeout": 120000,
    "stateless": true,
    "useNativeSessionContext": false,
    "thinking": "off",
    "isolatedStatePerRequest": true,
    "cleanupStateDirAfterRequest": true,
    "stateDirBase": "/tmp/iroseclaw-openclaw"
  },
  "providers": {
    "default": "default",
    "named": {
      "default": {
        "type": "openai-compatible",
        "baseUrl": "https://api.example.com/v1",
        "apiKey": "YOUR_API_KEY",
        "model": "deepseek-v3.2",
        "timeout": 30000,
        "enabled": false
      },
      "faramita": {
        "type": "openai-compatible",
        "baseUrl": "https://api.faramita.online/v1",
        "apiKey": "YOUR_FARAMITA_API_KEY",
        "model": "free-chat",
        "extraBody": {
          "enable_thinking": false
        },
        "timeout": 120000,
        "enabled": true
      }
    }
  },
  "music": {
    "playUrlProviders": [
      "iarcDirect",
      "metingRedirect",
      "neteaseOuter"
    ],
    "providers": {
      "customTemplate": {
        "enabled": false,
        "urlTemplate": ""
      },
      "iarcDirect": {
        "enabled": true,
        "urlTemplate": "https://v.iarc.top/?type=url&id={{id}}#.mp3"
      },
      "metingRedirect": {
        "enabled": true,
        "endpointTemplate": "https://api.injahow.cn/meting/?server=netease&type=url&id={{id}}"
      },
      "neteaseOuter": {
        "enabled": true,
        "urlTemplate": "https://music.163.com/song/media/outer/url?id={{id}}.mp3"
      }
    }
  },
  "messageMemory": {
    "enabled": true,
    "dataDir": "data/message-memory",
    "maxEventsPerChannel": 400,
    "recentMessageCount": 30,
    "maxAnchorRounds": 20,
    "compactCheckInterval": 50,
    "compactOnStartup": true,
    "maxMessageChars": 180,
    "persist": true
  },
  "meme": {
    "enabled": true,
    "triggerProbability": 0.5,
    "requestEmotionTag": true
  },
  "remotePlugins": {
    "entries": [
      {
        "url": "https://example.com/plugins/my-plugin.bundle.js",
        "enabled": false,
        "sha256": "",
        "timeout": 10000
      }
    ],
    "timeout": 10000,
    "allowHttp": false
  },
  "pluginConfigs": {
    "iirose-admin-follow-room": {
      "leaderUid": "YOUR_ADMIN_UID",
      "onlyWhenLeavingCurrentRoom": false
    }
  },
  "fallbackResponses": [
    "抱歉，我暂时无法处理这个请求。",
    "出了点问题，请稍后再试。",
    "我现在有点忙，晚点再聊吧。",
    "这个功能暂时不可用。"
  ],
  "rateLimit": {
    "perMinute": 60
  },
  "policy": {
    "allowHighRiskTools": true,
    "allowCrossSessionSend": true,
    "maxMessagesPerWorkflow": 3
  }
}
