{
  "name": "iroseclaw",
  "version": "0.1.0",
  "description": "IIROSE chatbot powered by OpenClaw — extensible Koishi plugin framework",
  "main": "src/index.js",
  "scripts": {
    "dev": "koishi start",
    "start:bg": "bash scripts/start-bg.sh",
    "stop:bg": "bash scripts/stop-bg.sh",
    "restart:bg": "bash scripts/restart-bg.sh",
    "status:bg": "bash scripts/status-bg.sh",
    "test": "node tests/run.js",
    "lint": "eslint src/",
    "config:extract": "node scripts/config-extract.js",
    "config:restore": "node scripts/config-restore.js"
  },
  "keywords": [
    "iirose",
    "koishi",
    "openclaw",
    "chatbot",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@koishijs/plugin-http": "^0.6.3",
    "@koishijs/plugin-proxy-agent": "^0.3.3",
    "koishi": "^4.18.0",
    "koishi-plugin-adapter-iirose": "^0.12.0"
  }
}
