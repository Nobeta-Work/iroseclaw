# OpenClaw 配置
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=1

# 日志级别 (DEBUG|INFO|WARN|ERROR)
LOG_LEVEL=INFO

# 机器人基础配置
IROSE_BOT_NAME=YourBotName
IROSE_BOT_UID=your_bot_uid
IROSE_BOT_USERNAME=your_bot_username
IROSE_BOT_PASSWORD=your_bot_password
IROSE_ROOM_ID=your_room_id

# 管理员 UID（逗号分隔）
IROSE_ADMINS=your_admin_uid

# AI Provider 配置
# ModelScope API Key
IROSE_MODELSCOPE_API_KEY=your_modelscope_api_key

# Kimi API Key (可选)
IROSE_KIMI_API_KEY=your_kimi_api_key

# OpenAI 兼容 API (可选)
IROSE_GENERAL_API_KEY=your_api_key
IROSE_GENERAL_BASE_URL=https://api.example.com/v1
